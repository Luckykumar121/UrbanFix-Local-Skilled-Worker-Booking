# Environment Variables for Render Deployment

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/urbanfix

# JWT Secret (Use a strong random string)
JWT_SECRET=your_very_strong_jwt_secret_key_here_change_this_in_production

# Email Configuration (Gmail or your email service)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Frontend URL (will be set by Render automatically)
FRONTEND_URL=https://urbanfix-frontend.onrender.com

# Backend URL (for frontend API calls)
VITE_API_URL=https://urbanfix-backend.onrender.com/api

# Node Environment
NODE_ENV=production

# Port (Render will automatically set this)
PORT=5000
